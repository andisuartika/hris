APP_NAME="HR Information System"
APP_ENV=local
APP_KEY=base64:
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=redis

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Keycloak SSO Configuration
# KEYCLOAK_BASE_URL: External URL for client-side redirects (browser)
# KEYCLOAK_INTERNAL_BASE_URL: Internal URL for server-to-server communication (Docker)
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_INTERNAL_BASE_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=hris
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8090/auth/callback

# Sanctum Token Expiration (in minutes)
SANCTUM_EXPIRATION=43200
